{
  "protocolVersion": 1,
  "plugin": {
    "publisher": "org.tsumugi",
    "id": "webvtt",
    "version": "0.1.0-alpha.1"
  },
  "permissions": [
    {
      "kind": "captured-input"
    }
  ],
  "components": [
    {
      "id": "caption-worker",
      "scope": "project",
      "runtime": "javascript",
      "entrypoint": "components/component.mjs",
      "dependencies": [],
      "exit": {
        "stopTimeoutMs": 1000,
        "cleanupTimeoutMs": 1000
      }
    }
  ],
  "contributions": [
    {
      "id": "extract-source",
      "componentId": "caption-worker",
      "contribution": {
        "kind": "capability",
        "declaration": {
          "contract": {
            "id": "webvtt.extract",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "inputSchema": {
            "id": "tsumugi.source-extraction-input",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "outputSchema": {
            "id": "tsumugi.content-exchange",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "errorSchema": {
            "id": "tsumugi.source-extraction-error",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "profiles": [
            {
              "id": "webvtt-captions",
              "schemaVersion": 1,
              "behaviorVersion": 1
            }
          ],
          "effect": "proposal",
          "permissions": [
            {
              "kind": "captured-input"
            }
          ],
          "limits": {
            "maxInputBytes": 2097152,
            "maxOutputBytes": 2097152,
            "concurrency": 1,
            "timeoutMs": 30000
          }
        }
      }
    },
    {
      "id": "build",
      "componentId": "caption-worker",
      "contribution": {
        "kind": "capability",
        "declaration": {
          "contract": {
            "id": "webvtt.locale-build",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "inputSchema": {
            "id": "webvtt.locale-build-input",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "outputSchema": {
            "id": "webvtt.locale-build-output",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "errorSchema": {
            "id": "webvtt.operation-error",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "profiles": [
            {
              "id": "webvtt-captions",
              "schemaVersion": 1,
              "behaviorVersion": 1
            }
          ],
          "effect": "proposal",
          "permissions": [
            {
              "kind": "captured-input"
            }
          ],
          "limits": {
            "maxInputBytes": 2097152,
            "maxOutputBytes": 2097152,
            "concurrency": 1,
            "timeoutMs": 30000
          }
        }
      }
    },
    {
      "id": "validate-artifact",
      "componentId": "caption-worker",
      "contribution": {
        "kind": "capability",
        "declaration": {
          "contract": {
            "id": "webvtt.artifact-check",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "inputSchema": {
            "id": "webvtt.artifact-check-input",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "outputSchema": {
            "id": "webvtt.artifact-check-output",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "errorSchema": {
            "id": "webvtt.operation-error",
            "schemaVersion": 1,
            "behaviorVersion": 1
          },
          "profiles": [
            {
              "id": "webvtt-captions",
              "schemaVersion": 1,
              "behaviorVersion": 1
            }
          ],
          "effect": "read-only",
          "permissions": [
            {
              "kind": "captured-input"
            }
          ],
          "limits": {
            "maxInputBytes": 2097152,
            "maxOutputBytes": 2097152,
            "concurrency": 1,
            "timeoutMs": 30000
          }
        }
      }
    }
  ]
}
