{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsumugi:webvtt:locale-build-input:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "template",
    "locale",
    "logicalPath",
    "cues"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utf8",
        "sha256"
      ],
      "properties": {
        "utf8": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "logicalPath": {
      "type": "string",
      "minLength": 5,
      "maxLength": 84,
      "pattern": "^(?!(?:[sS][oO][uU][rR][cC][eE]|[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])\\.vtt$)[A-Za-z0-9_-]{1,80}\\.vtt$",
      "description": "A root-level caption filename; directory components and reserved device/source names are rejected."
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "nativeId",
          "canonicalId",
          "sourceText",
          "targetText",
          "basis"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1999
          },
          "nativeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[ -~]+$"
          },
          "canonicalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[ -~]+$"
          },
          "sourceText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "targetText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "basis": {
            "$ref": "cue-basis.schema.json"
          }
        }
      }
    }
  },
  "description": "Exact decided cue coverage of a captured template. Unicode and actual UTF-8 byte limits, SHA-256, cue identities, source text and basis are checked by the component; JSON Schema alone cannot prove those relationships."
}
