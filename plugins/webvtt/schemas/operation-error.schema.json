{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsumugi:webvtt:operation-error:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "detail"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid-input",
        "invalid-template",
        "invalid-payload",
        "identity-mismatch",
        "invalid-output",
        "unsafe-path",
        "limit-exceeded",
        "cancelled"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Public static diagnostic only. Actual UTF-8 length is bounded; NUL is forbidden."
    }
  }
}
